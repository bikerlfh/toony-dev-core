# ---- Builder ----
FROM python:3.12-alpine AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apk add --no-cache gcc musl-dev libpq-dev \
    && pip install --no-cache-dir uv

WORKDIR /app

COPY requirements/ requirements/
RUN uv pip install --no-cache-dir --prefix=/install -r requirements/base.txt

# ---- Runtime ----
FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apk add --no-cache libpq \
    && adduser -D -h /home/app app

COPY --from=builder /install /usr/local

WORKDIR /app
COPY --chown=app:app . .

RUN SECRET_KEY=build-placeholder ENVIRONMENT=production \
    FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
    python manage.py collectstatic --noinput

USER app

EXPOSE 8080

CMD ["gunicorn", "config.asgi:application", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8080", "--workers", "4"]
